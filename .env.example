# Required
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agent_cartsmith_retail_demo
VOYAGE_API_KEY=pa-...
TAVILY_API_KEY=tvly-...

# NL->MQL data agent: the safety wrapper is fail-CLOSED. It refuses every
# collection until this CSV allow-list is set; it MUST match the operational
# seed file stems (examples/retail_assistant/seeds/operational/*.json).
# `promotions` is read-allow-listed (coupon terms the deal_optimizer
# reads). `carts` is intentionally NOT here — it is written only by the
# dedicated cart tools, so the NL->MQL agent can neither read nor mutate it.
DATA_AGENT_ALLOW_LIST=products,customers,orders,promotions

# Human-in-the-loop checkout. Set this to require approval before the
# main agent's `place_order` tool commits an order (interrupt/approve/edit/reject
# over the MongoDBSaver checkpoint). Leave empty to disable HITL entirely.
# HITL_TOOLS=place_order

# LLM provider (default: AWS Bedrock Claude Haiku 4.5)
LLM_PROVIDER=bedrock
LLM_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_DEFAULT_REGION=us-east-1
# AWS credentials: provide via an instance profile / AWS_PROFILE, or set them
# explicitly for local Bedrock auth (read directly by the boto3 SDK).
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Voyage (asymmetric retrieval: voyage-4 for documents, voyage-4-lite for queries)
VOYAGE_DOCUMENT_MODEL=voyage-4
VOYAGE_QUERY_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=1024
VOYAGE_RERANK_MODEL=rerank-2.5
# Optional: route Voyage through a gateway (e.g. MongoDB AI Gateway)
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Virtual filesystem (S3-only)
VFS_BACKEND=s3
VFS_MAX_BYTES=52428800
VFS_S3_BUCKET=deep-agent-artifacts
VFS_S3_PREFIX=deep-agent/retail-demo
VFS_S3_REGION=us-east-1

# LangSmith — SaaS, tracing only (smith.langchain.com -> Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agent-cartsmith-retail-demo

# MongoClient pool tuning (production-sized defaults; override for denser workloads)
# MONGODB_MAX_POOL_SIZE=100
# MONGODB_MIN_POOL_SIZE=10
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_SOCKET_TIMEOUT_MS=30000

# Agent log (replaces the legacy chat_history + plans collections)
# Provided by the langchain-mongodb-agent-log package.
# Per-message truncation cap (15 MiB; sized below the 16 MiB BSON ceiling).
AGENT_LOG_MAX_CONTENT_BYTES=15728640
AGENT_LOG_RETENTION_DAYS=90
# Optional: override the agent-log collection name (default: "agent_log")
# AGENT_LOG_COLLECTION=agent_log

# Hybrid search over past conversations (default ON)
# Set to false to disable Voyage embedding cost per super-step.
ENABLE_AGENT_LOG_SEARCH=true
AGENT_LOG_SEARCH_TEXT_MAX_BYTES=8192

# Operational primitives
READINESS_CACHE_TTL_S=5
SHUTDOWN_GRACE_PERIOD_S=30
# Deployed-image defaults. Multi-step storefront tasks (e.g. "find ingredients,
# prices, save a shopping list") exceed a 50-step ceiling -> GraphRecursionError,
# and 180s is too tight once the planner fans out tool calls. docker-compose.yml
# defaults to these same values.
CHAT_TURN_TIMEOUT_S=600
RECURSION_LIMIT=150

# Directory containing SKILL.md files loaded by deepagents.
# Default is the in-image path. For local dev: AGENT_SKILLS_DIR=AgentSkills
AGENT_SKILLS_DIR=/app/AgentSkills

# fetch_and_cache hardening
FETCH_MAX_BYTES=2097152

# Optional: least-privilege URI for the data-agent tool
# DATA_AGENT_MONGODB_URI=mongodb+srv://DATAAGENT:PASS@CLUSTER.mongodb.net/

# Optional: seed source override (default: examples/retail_assistant/seeds)
# SEEDS_DIR=/path/to/seeds

# Optional: host port overrides read by docker-compose.yml and scripts/deploy.sh
# (NOT by the Python app). Defaults: backend 8010, frontend 3000.
# DEEP_AGENT_PORT=8010
# FRONTEND_PORT=3000

# Query-keyed semantic RESPONSE cache (turn-level, default ON).
# Embeds ONLY the user query and stores the final answer, scoped by
# (user_id, model). Served only on a fresh conversation (first turn). Threshold
# 0.9 = near-exact match (safe); lower toward ~0.85 to also match paraphrases.
# TTL bounds staleness (prices/inventory drift). Disable -> no Voyage embed on
# lookup, no semantic_response_cache collection / index provisioned.
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_THRESHOLD=0.9
RESPONSE_CACHE_TTL_DAYS=7

# Dev only: loosen TLS enforcement (never set in prod)
# ALLOW_INSECURE=true
